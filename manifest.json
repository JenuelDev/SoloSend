{
  "manifest_version": 2,
  "name": "SoloSend",
  "version": "1.0.3",
  "description": "From the compose window, send your email to many recipients one at a time, with a delay between each — or schedule it for later.",
  "author": "Jenuel Oras Ganawed",
  "browser_specific_settings": {
    "gecko": {
      "id": "solosend@vocphone.com",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "32": "icons/icon-32.png",
    "64": "icons/icon-64.png"
  },
  "permissions": [
    "compose",
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "compose_action": {
    "default_title": "SoloSend",
    "default_icon": {
      "32": "icons/icon-32.png",
      "64": "icons/icon-64.png"
    }
  }
}
